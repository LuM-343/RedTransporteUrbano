<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TransporteUrbanoEDD.Core\TransporteUrbanoEDD.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Copia los CSV del Core a la carpeta de salida (bin/.../Datos) al compilar -->
  <ItemGroup>
    <None Include="..\TransporteUrbanoEDD.Core\Datos\*.csv"
          LinkBase="Datos"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
